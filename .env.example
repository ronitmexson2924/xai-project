# Copy to .env (git-ignored) and fill in. Never commit real values.
ENVIRONMENT=development          # "production" refuses to start with unsafe settings
DATABASE_URL=postgresql+psycopg://pcg:pcg@localhost:5432/pcg
JWT_SECRET=change-me             # production: a random string of 32+ characters
JWT_EXPIRE_HOURS=24
CORS_ORIGINS=http://localhost:3000
TRUST_FORWARDED_FOR=false        # true only behind a proxy that sets X-Forwarded-For
ANALYSIS_SALT=                   # pseudonym salt for research exports; fixed for the whole study
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=120
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_SECONDS=900
GEMINI_API_KEY=
# Model names are configuration, not code (fast model for runtime, stronger model for offline precompute)
GEMINI_MODEL_EXPLAIN=
GEMINI_MODEL_OFFLINE=
LLM_TIMEOUT_SECONDS=4
NEXT_PUBLIC_API_URL=http://localhost:8000
