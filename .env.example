# Copy to .env (git-ignored) and fill in. Never commit real values.
ENVIRONMENT=development # production refuses a weak JWT secret, wildcard CORS and draft items
DATABASE_URL=postgresql+psycopg://pcg:pcg@localhost:5432/pcg
JWT_SECRET=change-me # production: at least 32 random characters
JWT_EXPIRE_HOURS=24
CORS_ORIGINS=http://localhost:3000 # comma-separated frontend origins
EXPORT_SALT= # at least 16 random characters, or research exports are refused
INCLUDE_DRAFT_ITEMS=false # true serves items still awaiting review (demos and tests only)
TRUST_PROXY_HEADERS=false # true only behind a proxy that sets X-Forwarded-For
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=120
AUTH_RATE_LIMIT_PER_MINUTE=10 # login/register attempts per account
AUTH_IP_RATE_LIMIT_PER_MINUTE=60 # login/register attempts per client address
GEMINI_API_KEY=
# Model names are configuration, not code (fast model for runtime, stronger model for offline precompute)
GEMINI_MODEL_EXPLAIN=
GEMINI_MODEL_OFFLINE=
LLM_TIMEOUT_SECONDS=4
NEXT_PUBLIC_API_URL=http://localhost:8000
