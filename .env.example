# Copy to .env (git-ignored) and fill in. Never commit real values.
DATABASE_URL=postgresql+psycopg://pcg:pcg@localhost:5432/pcg
JWT_SECRET=change-me
GEMINI_API_KEY=
# Model names are configuration, not code (fast model for runtime, stronger model for offline precompute)
GEMINI_MODEL_EXPLAIN=
GEMINI_MODEL_OFFLINE=
LLM_TIMEOUT_SECONDS=4
NEXT_PUBLIC_API_URL=http://localhost:8000
